name: Publish stable release

on:
  push:
    tags: ['v*']

permissions:
  contents: read

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          fetch-depth: 0
      - name: Require a stable version on merged master
        shell: bash
        run: |
          [[ "$GITHUB_REF_NAME" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
          git merge-base --is-ancestor HEAD origin/master
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
        with:
          python-version: '3.13'
      - run: python -m pip install -e ".[dev]"
      - run: python -m pytest tests
      - run: python scripts/build_release.py --outdir dist --expected-version "$GITHUB_REF_NAME"
      - name: Prepare version notes
        run: |
          python -c "from pathlib import Path; text=Path('CHANGELOG.md').read_text(encoding='utf-8'); Path('release-notes.md').write_text(text.split('\n## ',2)[1],encoding='utf-8')"
      - name: Publish verified artifacts
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create "$GITHUB_REF_NAME" dist/*.whl dist/*.tar.gz dist/SHA256SUMS.txt dist/BUILD_INFO.json --verify-tag --title "wqb-cli ${GITHUB_REF_NAME#v}" --notes-file release-notes.md

