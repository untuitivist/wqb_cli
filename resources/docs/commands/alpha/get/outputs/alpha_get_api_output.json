      "regular": {
        "code": "from brain.alphas import alpha\nimport numpy as np\nimport numpy.typing as npt\n\ndef _pasteurize(a, universe):\n    a = a.copy()\n    a[~universe.astype(bool)] = np.nan\n    return a\n\n@alpha(data=[\"close\", \"high\", \"low\", \"volume\"], store=[])\ndef alpha_smooth2_range_sqrt_invvol025(data, store) -> npt.NDArray[np.float32]:\n    if data.close.shape[0] < 3:\n        return np.full(data.close.shape[1], np.nan, dtype=np.float32)\n    spread = data.high - data.low\n    spread = np.where(spread == 0, np.nan, spread)\n    hl_diff = ((data.close - data.low) - (data.high - data.close)) / spread\n    delta_hl = hl_diff[1:, :] - hl_diff[:-1, :]\n    base = -np.nanmean(delta_hl[-2:, :], axis=0)\n    range_pct = np.where(data.close[-1] == 0, np.nan, spread[-1] / data.close[-1])\n    vol = np.where(data.volume[-1] <= 0, np.nan, data.volume[-1])\n    a = base * np.sqrt(np.maximum(range_pct, 0)) / np.power(vol, 0.25)\n    a = _pasteurize(a, data.close[-1])\n    return a.astype(np.float32)",
        "description": "Idea: This alpha for machine alpha. This alpha for machine alpha.\nRationale for data used:  This alpha for machine alpha. This alpha for machine alpha.\nRationale for operators used:  This alpha for machine alpha. This alpha for machine alpha.",
