        "regular": {
          "code": "from brain.alphas import alpha\nimport numpy as np\nimport numpy.typing as npt\n\n\ndef _rank(x):\n    x = x.astype(float)\n    out = np.full(x.shape, np.nan, dtype=float)\n    valid = np.isfinite(x)\n    n = int(np.sum(valid))\n    if n <= 1:\n        return out\n    order = np.argsort(x[valid])\n    ranks = np.empty(n, dtype=float)\n    ranks[order] = np.arange(n, dtype=float)\n    out[valid] = (ranks / (n - 1.0)) - 0.5\n    return out\n\n\n@alpha(data=[\"chiehuang_nugget_predicted_position\", \"returns\", \"close\"], store=[])\ndef usa_d1_model_python_alpha(data, store) -> npt.NDArray[np.float32]:\n    if data.returns.shape[0] < 20:\n        return np.full(data.close.shape[1], np.nan, dtype=np.float32)\n    model_pos = data.chiehuang_nugget_predicted_position[-1]\n    signal = _rank(model_pos)\n    universe = np.isfinite(data.close[-1])\n    signal[~universe] = np.nan\n    signal[~np.isfinite(signal)] = np.nan\n    return signal.astype(np.float32)",
          "description": "Idea: This alpha for machine alpha. This alpha for machine alpha.\nRationale for data used:  This alpha for machine alpha. This alpha for machine alpha.\nRationale for operators used:  This alpha for machine alpha. This alpha for machine alpha.",
